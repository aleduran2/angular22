{
  "name": "angular22",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n api,catalogo,carrito,shell -c gray,green,yellow,cyan \"npm:api\" \"npm:start:catalogo\" \"npm:start:carrito\" \"npm:start:shell\"",
    "start:shell": "ng serve shell",
    "start:catalogo": "ng serve catalogo",
    "start:carrito": "ng serve carrito",
    "api": "node tools/mock-api/server.mjs",
    "build": "ng build catalogo && ng build carrito && ng build shell",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "e2e": "playwright test",
    "format": "prettier --write \"projects/**/*.{ts,html,css}\" \"e2e/**/*.ts\" \"tools/**/*.mjs\" \"*.ts\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,css}\" \"e2e/**/*.ts\" \"tools/**/*.mjs\" \"*.ts\""
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "es-module-shims": "^2.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^22.2.2",
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "1.56",
    "@softarc/native-federation-orchestrator": "^4.6.0",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
